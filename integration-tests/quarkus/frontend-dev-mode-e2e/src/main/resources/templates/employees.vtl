<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Staff Directory - Viet Template Dev Mode</title>
  $assets.head("src/pages/employees/index.ts")
</head>
<body>
  <main class="employees-page">
    <header class="page-header">
      <h1 data-testid="ssr-heading">Staff Directory</h1>
      <h2 data-testid="ssr-employee-name">Employee: $!employee.name</h2>
      <section class="department-info">
        <p data-testid="ssr-department">Department: $!departmentName</p>
        <p data-testid="vtl-version-container">VTL Version: <span data-testid="vtl-version">VTL-A</span></p>
        <p data-testid="java-version-container">Java Version: <span data-testid="java-version">$!javaVersion</span></p>
      </section>
    </header>

    <!-- Semantic SSR fallback rendered for all users and no-JS contexts -->
    <div id="employees-island" data-employee-island data-testid="employees-island">
      <div class="employees-card" data-testid="ssr-fallback-card">
        <h2>$!employee.name ($!employee.role)</h2>
        <p>Department: $!employee.department</p>
        <p class="ssr-follower-count">Followers: <span data-testid="ssr-followers">$!employee.followers</span></p>
        <form method="post" action="/employees/$!employee.id/follow" class="ssr-follow-form" data-testid="ssr-fallback-form">
          <button type="submit" data-testid="ssr-follow-button">Follow</button>
        </form>
      </div>
    </div>
  </main>

  <!-- Script-safe JSON client data for client-side island mounting -->
  $clientData.script("employees-data", $pageData)

  <!-- Entry module script -->
  $assets.body("src/pages/employees/index.ts")
</body>
</html>
