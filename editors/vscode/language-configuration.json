{
  "comments": {
    "lineComment": "##",
    "blockComment": ["#*", "*#"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" },
    { "open": "#*", "close": "*#" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"],
    ["#*", "*#"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*#(if|elseif|else|foreach|macro|define)\\b.*$",
    "decreaseIndentPattern": "^\\s*#(elseif|else|end)\\b.*$"
  }
}
