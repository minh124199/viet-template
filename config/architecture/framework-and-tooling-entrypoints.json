      "module": "viet-template-spring-boot-autoconfigure",
      "entrypointKind": "SPRING_BOOT_CONFIGURATION_PROPERTIES",
      "metadataSource": "@ConfigurationProperties(prefix = \"viet-template\") / VietTemplateAutoConfiguration",
