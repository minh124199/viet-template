      "mustHavePublicConstructor": true,
      "fqcnStabilityRequired": false,
      "userJavaApi": false,
      "stableApiClassification": "FRAMEWORK_ENTRYPOINT",
      "description": "Quarkus build-step processor orchestrating AOT template compilation, index generation, and native image configuration."
